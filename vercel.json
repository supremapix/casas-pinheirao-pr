{
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "yarn install",
  "routes": [
    {
      "src": "/blog$",
      "status": 308,
      "headers": {
        "Location": "/blog/"
      }
    },
    {
      "src": "/blog/como-construir-no-seu-terreno-com-economia$",
      "status": 308,
      "headers": {
        "Location": "/blog/como-construir-no-seu-terreno-com-economia/"
      }
    },
    {
      "src": "/blog/$",
      "dest": "/blog/index.html"
    },
    {
      "src": "/blog/como-construir-no-seu-terreno-com-economia/$",
      "dest": "/blog/como-construir-no-seu-terreno-com-economia/index.html"
    },
    {
      "src": "/blog/custo-da-construcao-2026-e-cenarios-2027-parana$",
      "status": 308,
      "headers": {
        "Location": "/blog/custo-da-construcao-2026-e-cenarios-2027-parana/"
      }
    },
    {
      "src": "/blog/custo-da-construcao-2026-e-cenarios-2027-parana/$",
      "dest": "/blog/custo-da-construcao-2026-e-cenarios-2027-parana/index.html"
    },
    {
      "src": "/blog/historia-casas-madeira-pre-fabricadas$",
      "status": 308,
      "headers": {
        "Location": "/blog/historia-casas-madeira-pre-fabricadas/"
      }
    },
    {
      "src": "/blog/historia-casas-madeira-pre-fabricadas/$",
      "dest": "/blog/historia-casas-madeira-pre-fabricadas/index.html"
    },
    {
      "src": "/blog/kit-montagem-obra-completa-casa-pre-fabricada$",
      "status": 308,
      "headers": {
        "Location": "/blog/kit-montagem-obra-completa-casa-pre-fabricada/"
      }
    },
    {
      "src": "/blog/kit-montagem-obra-completa-casa-pre-fabricada/$",
      "dest": "/blog/kit-montagem-obra-completa-casa-pre-fabricada/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/blog/.*",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
